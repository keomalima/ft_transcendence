### CREATE AN USER (AS JSON)
POST {{baseUrl}}/ HTTP/1.1
Content-Type: application/json

{
	"my": "teste",
	"email": "betsy@icloud.com",
	"name": "Betsy",
	"surname": "Lima",
	"displayName": "Betsy",
	"password": "123456",
	"city": "Lyon",
	"avatarUrl": null
}

