@baseUrl = http://localhost:3000/api/games
@token = 0543dfd9-c7ee-428b-af3e-b9802119b924
@userId = b6e1dea9-6308-4a41-87cc-ae71d8ab212c
@gameId = 04f2a750-3241-4339-a553-17ba232a3a1b

@gameToken = 0MXxxE3-

### GET A GAME
GET {{baseUrl}}/{{gameId}} HTTP/1.1
Authorization: Bearer {{token}}

### CREATE A GAME
POST {{baseUrl}}/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
   "type": "ONLINE",
   "scoreToWin": 10
}

### GENERATE A TOKEN
POST {{baseUrl}}/{{gameId}}/token HTTP/1.1
Authorization: Bearer {{token}}

### UPDATE A GAME
PUT {{baseUrl}}/{{gameId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
   "scoreToWin": 5
}

### JOIN A GAME
POST {{baseUrl}}/{{gameToken}}/join HTTP/1.1
Authorization: Bearer {{token}}

### START A GAME
PUT {{baseUrl}}/{{gameId}}/start HTTP/1.1
Authorization: Bearer {{token}}

### GET GAME HISTORY
GET {{baseUrl}}/history HTTP/1.1
Authorization: Bearer {{token}}