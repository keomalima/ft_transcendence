@baseUrl = http://localhost:3000/api/games
@token = 45ef9eca-3435-48d7-9355-28b13207ba9f
@userId = 0596fd31-71e3-4c34-bb7d-2cae13d4b165
@gameId = 04f2a750-3241-4339-a553-17ba232a3a1b

@gameToken = 0MXxxE3-

### GET A GAME
GET {{baseUrl}}/{{gameId}} HTTP/1.1
Authorization: Bearer {{token}}

### CREATE A GAME
POST {{baseUrl}}/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
   "type": "ONLINE",
   "scoreToWin": 10
}

### GENERATE A TOKEN
POST {{baseUrl}}/{{gameId}}/token HTTP/1.1
Authorization: Bearer {{token}}

### UPDATE A GAME
PUT {{baseUrl}}/{{gameId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
   "scoreToWin": 5
}

### JOIN A GAME
POST {{baseUrl}}/{{gameToken}}/join HTTP/1.1
Authorization: Bearer {{token}}

### START A GAME
PUT {{baseUrl}}/{{gameId}}/start HTTP/1.1
Authorization: Bearer {{token}}

### GET GAME HISTORY
GET {{baseUrl}}/history HTTP/1.1
Authorization: Bearer {{token}}

### GET CURRENT GAME
GET {{baseUrl}}/current HTTP/1.1
Authorization: Bearer {{token}}