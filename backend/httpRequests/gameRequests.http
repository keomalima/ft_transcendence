@baseUrl = http://localhost:3000/api/games
@token = 14f20f1c-c47f-426d-b704-6e68269541e1
@userId = 7342a938-228e-471e-bbac-0f43fec6e83f
@gameId = 4c6a298f-e5c4-404c-b579-a859c4d6a3e8

@gameToken = 0MXxxE3-

### GET A GAME
GET {{baseUrl}}/{{gameId}} HTTP/1.1
Authorization: Bearer {{token}}

### CREATE A GAME
POST {{baseUrl}}/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
   "type": "ONLINE",
   "scoreToWin": 10
}

### GENERATE A TOKEN
POST {{baseUrl}}/{{gameId}}/token HTTP/1.1
Authorization: Bearer {{token}}

### UPDATE A GAME
PUT {{baseUrl}}/{{gameId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
   "scoreToWin": 5
}

### JOIN A GAME
POST {{baseUrl}}/{{gameToken}}/join HTTP/1.1
Authorization: Bearer {{token}}

### START A GAME
PUT {{baseUrl}}/{{gameId}}/start HTTP/1.1
Authorization: Bearer {{token}}

### GET GAME HISTORY
GET {{baseUrl}}/history HTTP/1.1
Authorization: Bearer {{token}}