@baseUrl = http://localhost:3000/api/games
@token = 226036d2-c4c2-47b0-8a5c-e0067e2dfa94
@userId = 132a1eb9-90a3-4434-b48e-63b6148d603c
@gameId = 79fd271c-1b5d-4317-8353-898a0582c514

@gameToken = 0MXxxE3-

### GET A GAME
GET {{baseUrl}}/{{gameId}} HTTP/1.1
Authorization: Bearer {{token}}

### CREATE A GAME
POST {{baseUrl}}/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
   "type": "ONLINE",
   "scoreToWin": 10
}

### GENERATE A TOKEN
POST {{baseUrl}}/{{gameId}}/token HTTP/1.1
Authorization: Bearer {{token}}

### UPDATE A GAME
PUT {{baseUrl}}/{{gameId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
   "scoreToWin": 5
}

### JOIN A GAME
POST {{baseUrl}}/{{gameToken}}/join HTTP/1.1
Authorization: Bearer {{token}}

### START A GAME
PUT {{baseUrl}}/{{gameId}}/start HTTP/1.1
Authorization: Bearer {{token}}

### GET GAME HISTORY
GET {{baseUrl}}/history HTTP/1.1
Authorization: Bearer {{token}}

### GET CURRENT GAME
GET {{baseUrl}}/current HTTP/1.1
Authorization: Bearer {{token}}

### REMOVE PLAYER FROM GAME
PUT {{baseUrl}}/{{gameId}}/remove HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
   "playerId": "0596fd31-71e3-4c34-bb7d-2cae13d4b165"
}

### DELETE OR QUIT PENDING GAME
DELETE {{baseUrl}}/{{gameId}} HTTP/1.1
Authorization: Bearer {{token}}