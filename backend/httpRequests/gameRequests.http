@baseUrl = http://localhost:3000/api/games
@token = 168a0b82-bb30-434b-8333-4bfb12312243
@userId = 8dda7613-7e48-4519-9297-c386b8c4972d
@gameId = ab7ea4b0-7874-4b20-9604-73c94bf2e619

@gameToken = 0MXxxE3-

### GET A GAME
GET {{baseUrl}}/{{gameId}} HTTP/1.1
Authorization: Bearer {{token}}

### CREATE A GAME
POST {{baseUrl}}/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
   "type": "ONLINE",
   "scoreToWin": 10
}

### GENERATE A TOKEN
POST {{baseUrl}}/{{gameId}}/token HTTP/1.1
Authorization: Bearer {{token}}

### UPDATE A GAME
PUT {{baseUrl}}/{{gameId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
   "scoreToWin": 5
}

### JOIN A GAME
POST {{baseUrl}}/{{gameToken}}/join HTTP/1.1
Authorization: Bearer {{token}}

### START A GAME
PUT {{baseUrl}}/{{gameId}}/start HTTP/1.1
Authorization: Bearer {{token}}