@baseUrl = http://localhost:3000/api/games
@token = 1be738d4-c9f7-4c76-97a9-9bcff179b6ee
@userId = d4424ed1-c537-496f-b848-85e8fb6d7dfa
@gameId = 59ebe32b-3e35-4f6b-8b24-efb72d31b488

@gameToken = 0MXxxE3-

### GET A GAME
GET {{baseUrl}}/{{gameId}} HTTP/1.1
Authorization: Bearer {{token}}

### CREATE A GAME
POST {{baseUrl}}/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
   "type": "ONLINE",
   "scoreToWin": 10
}

### GENERATE A TOKEN
POST {{baseUrl}}/{{gameId}}/token HTTP/1.1
Authorization: Bearer {{token}}

### UPDATE A GAME
PUT {{baseUrl}}/{{gameId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
   "scoreToWin": 5
}

### JOIN A GAME
POST {{baseUrl}}/{{gameToken}}/join HTTP/1.1
Authorization: Bearer {{token}}

### START A GAME
PUT {{baseUrl}}/{{gameId}}/start HTTP/1.1
Authorization: Bearer {{token}}