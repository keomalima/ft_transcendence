{
    "compilerOptions": {
        "target": "ES2018",
        "module": "ES2020",
        "moduleResolution": "Node",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "sourceMap": true,
        "noEmitOnError": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable", "esnext"]  // Added DOM for browser APIs
    },
    "include": ["src/**/*"],
	"downlevelIteration": true
}
