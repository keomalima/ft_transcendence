{
    "github.copilot.enable": {
        "*": false
    },
    "files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		"frontend": false,
		".vscode": true,
		"**/*.json": true,
		"**/*.yml": true,
		"**/*.md": true,
		".gitignore": true,
		"Makefile": true,
		"node_modules": true,
		"prisma": true,
		"**/*.ts": false,
		"**/node_modules": true,
		"**/prisma": true,
		"**/.dockerignore": true,
		"**/.env": true,
		"**/.gitignore": true,
		"**/Dockerfile": true,
		"backend/src/*.*": true,
		"**/generated": true,
		"*.pdf": false,
		"en.subject.pdf": false,
		"prisma.config.ts": true,
		"**/prisma.config.ts": true,
		"**/dist": true,
		"backend/data": true,
		"**/types": false,
		"**/registers": true,
		"backend": true,
		"**/old_version": true
	},
    "explorerExclude.backup": {},
    "files.autoSave": "afterDelay",

	"editor.insertSpaces": false,
	"editor.tabSize": 4,
	"editor.detectIndentation": false,
	"editor.useTabStops": true

}
