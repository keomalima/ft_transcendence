{
    "github.copilot.enable": {
        "*": false
    },
    "files.exclude": {
		"**/.git": false,
		"**/.svn": false,
		"**/.hg": false,
		"**/.DS_Store": false,
		"**/Thumbs.db": false,
		"frontend": false,
		".vscode": false,
		"**/*.json": false,
		"**/*.yml": false,
		"**/*.md": false,
		".gitignore": false,
		"Makefile": false,
		"node_modules": false,
		"**/node_modules": false,
		"**/.dockerignore": false,
		"**/.env": false,
		"**/.gitignore": false,
		"**/Dockerfile": false,
		"**/generated": false,
		"*.pdf": false,
		"en.subject.pdf": false,
		"prisma.config.ts": false,
		"**/prisma.config.ts": false,
		"**/dist": false,
		"**/types": false,
		"**/registers": false,
		"**/old_version": false,
		"**/backend": false,
		"**/.vscode": false,
		"**/fix-imports.js": false,
		"**/*.mjs": false,
		"**/tailwind.config.js": false
	},
    "explorerExclude.backup": {},
    "explorerExclude.backup": {},
    "files.autoSave": "afterDelay",

	"editor.insertSpaces": false,
	"editor.tabSize": 4,
	"editor.detectIndentation": false,
	"editor.useTabStops": true

}
