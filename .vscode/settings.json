{
    "github.copilot.enable": {
        "*": false
    },
    "files.exclude": {
		"**/.git": false,
		"**/.svn": false,
		"**/.hg": false,
		"**/.DS_Store": false,
		"**/Thumbs.db": false,
		"**/CVS": false,
		"**/*.git": false,
		"**/.vscode": false,
		"docker-compose.yml": false,
		"**/*.json": false,
		".gitignore": false,
		"Makefile": false,
		"**/node_modules": false,
		"**/dist": false,
		"**/scripts": false,
		"**/*.js": false,
		"**/*.mjs": false,
		"**/*.css": false,
		"**/.gitignore": false,
		"frontend/ARCHITECTURE.md": false,
		"nginx": false,
		"README.md": false,
		"pong.py": false,
		"**/*.html": false,
		"**/Dockerfile": false,
		"**/animationPlayground": false,
		"**/docs": false,
		"**/styles": false,
		"frontend/src/config.ts": false,
		"frontend/src/types.d.ts": false,
		"frontend/src/utils": false,
		"frontend/src/data": false,
		"frontend/src/images": false,
		"backend/.dockerignore": false,
		"backend/.env": false,
		"backend/uploads": false,
		"backend/data": false,
		"backend/src/generated": false
	},
    "explorerExclude.backup": {},
    "explorerExclude.backup": {},
    "files.autoSave": "afterDelay",

	"editor.insertSpaces": false,
	"editor.tabSize": 4,
	"editor.detectIndentation": false,
	"editor.useTabStops": true

}
