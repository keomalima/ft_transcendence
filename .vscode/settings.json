{
    "github.copilot.enable": {
        "*": false
    },
    "files.exclude": {
		"**/.git": false,
		"**/.svn": false,
		"**/.hg": false,
		"**/.DS_Store": false,
		"**/Thumbs.db": false,
		"frontend": false,
		".vscode": true,
		"**/*.json": true,
		"**/*.yml": true,
		"**/*.md": true,
		".gitignore": true,
		"Makefile": false,
		"node_modules": false,
		"prisma": false,
		"**/*.ts": false,
		"**/node_modules": false,
		"**/prisma": false,
		"**/.dockerignore": true,
		"**/.env": false,
		"**/.gitignore": false,
		"**/Dockerfile": true,
		"backend/src/*.*": false,
		"**/generated": false,
		"*.pdf": false,
		"en.subject.pdf": false,
		"prisma.config.ts": false,
		"**/prisma.config.ts": false,
		"**/dist": false,
		"backend/data": false,
		"**/types": false,
		"**/registers": false,
		"backend": true,
		"**/old_version": false
	},
    "explorerExclude.backup": {},
    "files.autoSave": "afterDelay",

	"editor.insertSpaces": false,
	"editor.tabSize": 4,
	"editor.detectIndentation": false,
	"editor.useTabStops": true

}
