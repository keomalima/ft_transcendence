{
    "github.copilot.enable": {
        "*": false
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "frontend": true,
        ".vscode": true,
        "**/*.json": true,
        "**/*.yml": true,
        "**/*.md": true,
        ".gitignore": true,
        "Makefile": false,
        "node_modules": true,
        "prisma": false,
        "**/*.ts": false,
        "**/node_modules": true,
        "**/prisma": true,
        "**/.dockerignore": true,
        "**/.env": true,
        "**/.gitignore": true,
        "**/Dockerfile": false,
        "backend/src/*.*": false,
        "**/generated": true,
        "*.pdf": true,
        "en.subject.pdf": true,
        "prisma.config.ts": true,
        "**/prisma.config.ts": true
    },
    "explorerExclude.backup": {},
    "files.autoSave": "afterDelay"
}