{
    "github.copilot.enable": {
        "*": false
    },
    "files.exclude": {
		"**/.git": false,
		"**/.svn": false,
		"**/.hg": false,
		"**/.DS_Store": false,
		"**/Thumbs.db": false
	},
    "explorerExclude.backup": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true
	},
    "explorerExclude.backup": {},
    "files.autoSave": "afterDelay",

	"editor.insertSpaces": false,
	"editor.tabSize": 4,
	"editor.detectIndentation": false,
	"editor.useTabStops": true,
	"json.schemas": [

	]

}
